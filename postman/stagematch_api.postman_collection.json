                {
                    "name": "Register student",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Emma de Boer\",\n    \"email\": \"emma@stagematch.test\",\n    \"password\": \"wachtwoord\",\n    \"role\": \"student\"\n}"
                        }
                    }
                },
                {
                    "name": "Register bedrijf",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Dolor B.V.\",\n    \"email\": \"info@dolor.test\",\n    \"password\": \"wachtwoord\",\n    \"role\": \"company\"\n}"
                        }
                    }
                },
                {
                    "name": "Login student",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"jan@stagematch.test\",\n    \"password\": \"wachtwoord\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.data && json.data.token) {",
                                    "    pm.collectionVariables.set('token_student', json.data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login bedrijf",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"info@pixelwerk.test\",\n    \"password\": \"wachtwoord\"\n}"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.data && json.data.token) {",
                                    "    pm.collectionVariables.set('token_company', json.data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Me",
